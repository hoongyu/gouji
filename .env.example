# Copy to .env and fill in. Never commit .env. Everything runs without any key in sample mode.

# Model providers (OpenAI-compatible). Without them the planner and reporter are scripted.
DEEPSEEK_API_KEY=your-deepseek-key
NVIDIA_API_KEY=your-nvidia-build-key        # Nemotron red team (scripts/red_team.py)
GOUJI_PLANNER_MODEL=deepseek-flash
GOUJI_REPORTER_MODEL=deepseek-flash

# Zetaris: when ZETARIS_HOST is set (and SAMPLE_MODE is not true) every check runs on Zetaris.
ZETARIS_HOST=
ZETARIS_PORT=443
ZETARIS_USER=
ZETARIS_PASSWORD=
ZETARIS_CATALOG=
# logical=qualified pairs for the nine tables the checks use
ZETARIS_TABLES=purchase_orders=erp.public.purchase_orders,goods_receipts=erp.public.goods_receipts,invoices=erp.public.invoices,payments=erp.public.payments,vendors=vm.public.vendors,vendor_changes=vm.public.vendor_changes,contracts=files.contracts,mailbox=files.mailbox,registry=files.registry

# Execution contracts are signed with this key (a random per-process key if unset).
CONTRACT_SIGNING_KEY=change-me-to-at-least-16-bytes

SAMPLE_MODE=false
PORT=8000
