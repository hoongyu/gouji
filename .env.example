# Copy to .env and fill in. Never commit .env. Everything runs without any key in sample mode.

# Model providers (OpenAI-compatible). Without them the planner and reporter are scripted and the Guard uses patterns only.
DEEPSEEK_API_KEY=your-deepseek-key
NVIDIA_API_KEY=your-nvidia-build-key        # Nemotron writes the held-out red-team set (python run.py heldout)
GOUJI_PLANNER_MODEL=deepseek-flash
GOUJI_REPORTER_MODEL=deepseek-flash
GOUJI_GUARD_MODEL=deepseek-flash

# Zetaris: when ZETARIS_REST_URL and ZETARIS_API_KEY are set (and SAMPLE_MODE is not true), every check
# runs on Zetaris through its REST API. Create the key in the Zetaris UI (Management -> API Tokens); the
# organisation id is the number under Management -> Organisation.
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
# Optional: GOUJI_BACKEND=local or zetaris forces one backend (default auto)
# GOUJI_BACKEND=auto
# Optional: where the nine tables live in Zetaris, if not the defaults in gouji/harness.py
# ZETARIS_TABLES=invoices=erp.invoices,...

# Execution contracts are signed with this key (a random per-process key if unset).
CONTRACT_SIGNING_KEY=change-me-to-at-least-16-bytes

SAMPLE_MODE=false
PORT=8000
