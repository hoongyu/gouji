.hackertrip/
.env
.env.*
node_modules/
__pycache__/
.venv/
dist/

# 主办方材料和别场的 PDF 不进公开仓库
resource/
# 例外：密钥模板要进仓库
!.env.example

logs/

# local tool settings
.claude/
output_examples/eval-ci-*

# demo video: raw takes and renders stay local
video/input/
video/out/
video/samples/

# explainer video: takes, screenshots and renders stay local
video/explainer/out/
video/explainer/audio/*.mp3
video/explainer/assets/

# signing keys: private halves never leave this machine; public halves are committed
keys/*.key
keys/notary.pub

# old demo pipeline: screenshots and logs stay local
video/shots/
video/compose.log
